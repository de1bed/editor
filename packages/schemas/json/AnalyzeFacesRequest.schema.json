{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/AnalyzeFacesRequest",
  "$defs": {
    "AnalyzeFacesRequest": {
      "type": "object",
      "properties": {
        "jobId": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "assetId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "video": {
          "$ref": "#/$defs/StorageRef"
        },
        "startMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "endMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "sampleFps": {
          "default": 5,
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 30
        },
        "speakerTurns": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "speaker": {
                "type": "string"
              },
              "startMs": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "endMs": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "speaker",
              "startMs",
              "endMs"
            ]
          }
        }
      },
      "required": [
        "assetId",
        "video",
        "startMs",
        "endMs"
      ],
      "title": "AnalyzeFacesRequest"
    },
    "StorageRef": {
      "type": "object",
      "properties": {
        "bucket": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "bucket",
        "path"
      ]
    }
  },
  "$id": "https://editor.local/schemas/AnalyzeFacesRequest.schema.json"
}
