{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/Job",
  "$defs": {
    "Job": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "userId": {
          "type": "string"
        },
        "projectId": {
          "type": [
            "string",
            "null"
          ]
        },
        "type": {
          "type": "string",
          "enum": [
            "fetch_url",
            "ingest",
            "transcribe",
            "select_moments",
            "analyze_faces",
            "build_timeline",
            "detect_objects",
            "render_preview",
            "render_final"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "queued",
            "running",
            "waiting",
            "succeeded",
            "failed",
            "canceled"
          ]
        },
        "progress": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "step": {
          "type": [
            "string",
            "null"
          ]
        },
        "idempotencyKey": {
          "type": "string"
        },
        "input": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "output": {
          "anyOf": [
            {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {}
            },
            {
              "type": "null"
            }
          ]
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "attempts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "id",
        "userId",
        "projectId",
        "type",
        "status",
        "progress",
        "step",
        "idempotencyKey",
        "input",
        "output",
        "error",
        "attempts"
      ],
      "title": "Job"
    }
  },
  "$id": "https://editor.local/schemas/Job.schema.json"
}
