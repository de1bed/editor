{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/FaceAnalysis",
  "$defs": {
    "FaceAnalysis": {
      "type": "object",
      "properties": {
        "assetId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "sampleFps": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "width": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "height": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "tracks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FaceTrack"
          }
        }
      },
      "required": [
        "assetId",
        "sampleFps",
        "width",
        "height",
        "tracks"
      ],
      "title": "FaceAnalysis"
    },
    "FaceTrack": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "speakerId": {
          "type": [
            "string",
            "null"
          ]
        },
        "startMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "endMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "keyframes": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "tMs": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "x": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "y": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "w": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "h": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "mouthActivity": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "tMs",
              "x",
              "y",
              "w",
              "h"
            ]
          }
        }
      },
      "required": [
        "id",
        "speakerId",
        "startMs",
        "endMs",
        "keyframes"
      ]
    }
  },
  "$id": "https://editor.local/schemas/FaceAnalysis.schema.json"
}
