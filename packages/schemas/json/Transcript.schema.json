{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/Transcript",
  "$defs": {
    "Transcript": {
      "type": "object",
      "properties": {
        "assetId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "language": {
          "type": "string",
          "minLength": 2,
          "maxLength": 8
        },
        "provider": {
          "type": "string",
          "enum": [
            "whisperx",
            "deepgram",
            "assemblyai",
            "fixture"
          ]
        },
        "providerVersion": {
          "default": "",
          "type": "string"
        },
        "durationMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "words": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Word"
          }
        },
        "speakers": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "label"
            ]
          }
        },
        "sentences": {
          "default": [],
          "type": "array",
          "items": {
            "$ref": "#/$defs/Sentence"
          }
        }
      },
      "required": [
        "assetId",
        "language",
        "provider",
        "durationMs",
        "words"
      ],
      "title": "Transcript"
    },
    "Word": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "text": {
          "type": "string"
        },
        "startMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "endMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "speaker": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "confidence": {
          "default": 1,
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "id",
        "text",
        "startMs",
        "endMs"
      ]
    },
    "Sentence": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "startMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "endMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "wordIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "speaker": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "startMs",
        "endMs",
        "wordIds"
      ]
    }
  },
  "$id": "https://editor.local/schemas/Transcript.schema.json"
}
