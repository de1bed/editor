{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/FetchUrlResult",
  "$defs": {
    "FetchUrlResult": {
      "type": "object",
      "properties": {
        "out": {
          "$ref": "#/$defs/StorageRef"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "title": {
          "type": "string"
        },
        "durationMs": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "mimeType": {
          "type": "string"
        }
      },
      "required": [
        "out",
        "bytes",
        "title",
        "durationMs",
        "mimeType"
      ],
      "title": "FetchUrlResult"
    },
    "StorageRef": {
      "type": "object",
      "properties": {
        "bucket": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "bucket",
        "path"
      ]
    }
  },
  "$id": "https://editor.local/schemas/FetchUrlResult.schema.json"
}
