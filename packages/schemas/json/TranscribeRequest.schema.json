{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/TranscribeRequest",
  "$defs": {
    "TranscribeRequest": {
      "type": "object",
      "properties": {
        "jobId": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "assetId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "audio": {
          "$ref": "#/$defs/StorageRef"
        },
        "out": {
          "$ref": "#/$defs/StorageRef"
        },
        "language": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "diarize": {
          "default": true,
          "type": "boolean"
        },
        "minSpeakers": {
          "default": null,
          "anyOf": [
            {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "maxSpeakers": {
          "default": null,
          "anyOf": [
            {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "assetId",
        "audio",
        "out"
      ],
      "title": "TranscribeRequest"
    },
    "StorageRef": {
      "type": "object",
      "properties": {
        "bucket": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "bucket",
        "path"
      ]
    }
  },
  "$id": "https://editor.local/schemas/TranscribeRequest.schema.json"
}
