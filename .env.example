# Copy to .env (and apps/web/.env.local for Next.js). Never commit real values.
# ─────────────────────────────────────────────────────────────── Supabase
# Project URL and keys: Supabase dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Public (anon/publishable) key. Safe in the browser: RLS protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only (jobs, workers). Bypasses RLS — never expose it to the browser.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ─────────────────────────────────────────────────────────────── Jobs
# inline  = jobs run inside the Next.js server process (local development)
# trigger = jobs are dispatched to Trigger.dev (production)
JOB_RUNNER=inline
# Trigger.dev (only with JOB_RUNNER=trigger): dashboard → API keys / Project settings.
TRIGGER_SECRET_KEY=
TRIGGER_PROJECT_REF=
# Where caption fonts live on Trigger.dev machines (MEDIA_WORKER=local there).
FONTS_DIR=

# ─────────────────────────────────────────────────────────────── Media workers
# local = ffmpeg on this machine (ingest + render; no GPU: centered crop, no detection)
# modal = Modal workers (workers/media): WhisperX, faces/active speaker, detection, render
MEDIA_WORKER=local
# URL printed by `modal deploy media/modal_app.py` for the `api` function.
MODAL_API_URL=
# Shared secret between this app and the Modal API (also stored in the Modal secret "editor-worker").
MEDIA_WORKER_TOKEN=
# Optional binary paths.
FFMPEG_PATH=
YTDLP_PATH=

# ─────────────────────────────────────────────────────────────── Transcription
# whisperx (Modal GPU, cheapest at volume) | deepgram | assemblyai
TRANSCRIBER=whisperx
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
ASSEMBLYAI_API_KEY=

# ─────────────────────────────────────────────────────────────── LLM
# anthropic | openai
LLM_PROVIDER=anthropic
# Main model (agent, clip selection) and fast model (bulk scoring, classification).
LLM_MODEL=claude-sonnet-5
LLM_FAST_MODEL=claude-haiku-4-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Embeddings for style-learning retrieval (Anthropic has no embeddings API).
EMBEDDINGS_PROVIDER=openai
EMBEDDINGS_MODEL=text-embedding-3-small

# ─────────────────────────────────────────────────────────────── MCP server
# Base URL of the web app (the MCP server calls its API with a personal token).
MCP_APP_URL=http://localhost:3000
# Personal MCP token (create one in the app: Mi estilo → Tokens MCP) for stdio clients.
MCP_TOKEN=

# ─────────────────────────────────────────────────────────────── Feature flags
# YouTube import: OFF by default. Users must confirm they own the rights.
NEXT_PUBLIC_FEATURE_YOUTUBE_INGEST=false
# Enables /dev/* pages in production builds (fixture player). Leave false.
ENABLE_DEV_PAGES=false
